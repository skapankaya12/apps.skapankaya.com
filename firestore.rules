rules_version = '2';

// Firestore security rules for Apps Marketplace.
// Deploy with:  firebase deploy --only firestore:rules
// The data model mirrors lib/types.ts (users, listings, categories, purchases).

service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // A user reads their own doc; admins read anyone's.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // New accounts always start as a buyer — nobody self-provisions as admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'buyer';

      // Users may update their own doc, but can only ever hold role buyer/seller.
      // Admins are assigned out-of-band (console / Admin SDK) and can set any role.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.role in ['buyer', 'seller']);

      allow delete: if isAdmin();
    }

    /* -----------------------------------------------------------------------
       Seller handles: the {handle} in /seller/{handle}.

       This collection exists because Firestore cannot enforce that a field is
       unique. A document id is unique by construction, so the handle IS the
       document id and claiming one is a create that can only succeed while it
       is free.

       It is also the ONLY public map from a handle to a seller, since /users
       below is readable by its owner alone. Resolution must always go through
       here and never through a field on the user document: this collection is
       the record of who owns a handle.
    ----------------------------------------------------------------------- */
    match /handles/{handle} {
      // Public: the account page checks availability before submitting, and
      // every visitor loading a profile needs to resolve the handle.
      allow read: if true;

      // First come, first served. The format is re-checked here rather than
      // trusted from lib/handles.ts, because a handle is public identity and
      // the client asserting its own validity is not a control.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handle
        && handle.matches('^[a-z0-9]([a-z0-9-]{1,28})[a-z0-9]$');

      // Only the owner touches an existing handle, and only to flip `active`
      // when renaming. Rewriting uid is refused, so a handle can never be
      // handed to, or blamed on, another account.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      // Never released back into the pool. A retired handle keeps pointing at
      // its original owner so a bookmarked profile URL cannot one day resolve
      // to a different person.
      allow delete: if isAdmin();
    }

    match /listings/{id} {
      // Anyone may read approved listings; sellers read their own; admins read all.
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();

      // Sellers create their own listings, which must enter the review queue.
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';

      /*
        Admins change status and notes freely. A seller gets four moves on their
        own listing, and never the right to approve it.

        The rule that used to be here allowed a seller to edit only while the
        listing was pending or rejected, which meant a live tool could not be
        touched at all: fixing a typo was impossible through the UI, and the
        code path that would have done it sent the listing back to the queue,
        pulling it off sale until someone reviewed a description change.

        The dividing line now is whether a change alters what the buyer
        receives. It does not for a price or a screenshot. It does for the
        package, which is the product.
      */
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Written only by the Stripe webhook through the Admin SDK, which
      // bypasses these rules. No seller edit has any business touching them.
      function serverOwnedIntact() {
        return !changed().hasAny(['sellerId', 'salesCount', 'slug', 'createdAt']);
      }
      // Mirrors REVIEW_CRITICAL_FIELDS in lib/types.ts. packageVerification is
      // here too: a seller must not be able to stamp their own installer as
      // having passed Apple's checks.
      function reviewedPartsIntact() {
        return !changed().hasAny([
          'packagePath', 'priceCents', 'runtime', 'setupMode', 'platform',
          'version', 'packageVerification'
        ]);
      }
      /*
        The price band, which holds on every seller write whatever the status.

        Two different controls, and both are wanted. priceCents is in the list
        above, so changing the price of a live listing sends it back to the
        queue and a human sees the new number: every listing here is approved by
        hand, and a price that could move afterwards would mean the number
        reviewed was not the number charged. The band is the cheaper backstop
        underneath that, and it matters most on the paths where no second review
        happens at all. It lived only in the submit form until now, which is to
        say it was not a control. Mirrors the $15 to $250 the form enforces.
        Note BUSINESS_MODEL.md still quotes an older $10 to $29 band.
      */
      function priceInBand() {
        return request.resource.data.priceCents is int
          && request.resource.data.priceCents >= 1500
          && request.resource.data.priceCents <= 25000;
      }

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && serverOwnedIntact()
            && priceInBand()
            && (
              // 1. Editing something that is not on sale. Unchanged behaviour:
              //    it stays in, or goes back to, the review queue.
              (resource.data.status in ['pending', 'rejected']
               && request.resource.data.status in ['pending', 'rejected'])

              // 2. Taking a live tool off sale, or putting it back. A
              //    visibility switch and nothing else, so no other field may
              //    move in the same write.
              || (resource.data.status in ['approved', 'unlisted']
                  && request.resource.data.status in ['approved', 'unlisted']
                  && changed().hasOnly(['status', 'updatedAt']))

              // 3. Editing a listing that has already been reviewed, in place.
              //    Presentation only, and it keeps whatever status it had, so
              //    a live tool stays live and one that is off sale stays off.
              || (resource.data.status in ['approved', 'unlisted']
                  && request.resource.data.status == resource.data.status
                  && reviewedPartsIntact())

              // 4. Replacing the package, or changing how the tool runs. That
              //    is a different product from the one that was reviewed, so
              //    it goes back to the queue. Taking a listing off sale first
              //    is not a way around this.
              || (resource.data.status in ['approved', 'unlisted']
                  && request.resource.data.status == 'pending')
            ));

      allow delete: if isAdmin();
    }

    match /categories/{id} {
      // The browse filters are public vocabulary — every visitor needs them to
      // render the chips and the badge on a listing. Only an admin edits them.
      allow read: if true;

      // A malformed category document breaks browse for everyone, so the shape
      // is checked here rather than trusted from the console. These hold after a
      // merge write too: request.resource.data is the document as it will be.
      allow create, update: if isAdmin()
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 60
        && request.resource.data.order is number;

      allow delete: if isAdmin();
    }

    /* -----------------------------------------------------------------------
       Saved listings, one document per person per listing.

       The document id is `{uid}_{listingId}` and the create rule checks that it
       matches, which is what stops one person saving the same tool repeatedly
       to inflate the number on it. A document id is the only uniqueness
       Firestore offers.

       A save is private. Nobody, including the seller, may read whose saves
       these are: the count published on a listing is worked out server-side
       with the Admin SDK (lib/saves.server.ts), so the marketplace can show a
       number without showing a list of who is interested in what.
    ----------------------------------------------------------------------- */
    match /bookmarks/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.listingId is string
        && id == request.auth.uid + '_' + request.resource.data.listingId;

      // Only reachable by the one-off adoption of saves made before these were
      // stored server-side, which rewrites a row it already owns.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.listingId == resource.data.listingId;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /* -----------------------------------------------------------------------
       Free tools: the directory at /free. Mirrors lib/types.ts FreeTool.

       A separate collection from listings on purpose, and the rules stay simple
       because there is nothing to deliver: no package path to bind to an owner,
       no price to keep in a band, no purchase to protect. What has to hold is
       that a submitter cannot approve their own entry and cannot edit one after
       it has been approved, because the whole value of the directory is that a
       human looked at every link in it.
    ----------------------------------------------------------------------- */
    match /freeTools/{id} {
      // Approved entries are world-readable; a submitter sees their own; admins
      // see everything, which is what the review queue reads.
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.submitterId == request.auth.uid)
        || isAdmin();

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      /*
        Shape checks, held on every non-admin write.

        `url` is the entire point of the record and the one field a visitor
        clicks, so http and javascript: are refused here rather than only in the
        form. The length caps mirror FREE_TOOL_TITLE_MAX and
        FREE_TOOL_DESCRIPTION_MAX so a script cannot write a card the page
        cannot lay out.
      */
      function validFreeTool() {
        let d = request.resource.data;
        return d.url is string
          && d.url.matches('https://.*')
          && d.url.size() <= 2000
          && d.title is string
          && d.title.size() > 0
          && d.title.size() <= 70
          && d.description is string
          && d.description.size() > 0
          && d.description.size() <= 240
          && d.category is string
          && d.submitterName is string;
      }

      // Anyone signed in may submit, and a submission always enters the queue.
      allow create: if isSignedIn()
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validFreeTool();

      /*
        An admin edits anything, including status, which is how review happens.

        A submitter may only fix their own entry while it is still pending, and
        may never touch status, ownership or the created stamp. Once it is
        approved the record is the reviewed thing, so further edits go through
        an admin. That is the opposite of the listings rule, deliberately: a
        seller edits a live listing because they own the product, and nobody
        owns a link except the site that vouched for it.
      */
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.submitterId == request.auth.uid
            && resource.data.status == 'pending'
            && !changed().hasAny(['submitterId', 'status', 'createdAt'])
            && validFreeTool());

      allow delete: if isAdmin();
    }

    match /purchases/{id} {
      // A buyer reads their own purchases; admins read all.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.buyerId || isAdmin());

      // Purchases are written ONLY by the Stripe webhook via the Admin SDK,
      // which bypasses these rules. Never writable from the client.
      allow write: if false;
    }
  }
}
