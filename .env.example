# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Firebase (Project settings → General → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side, for webhooks and secure writes): service account
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional: Firebase App Check (reCAPTCHA v3). Register the site in the Firebase
# console → App Check, then paste the reCAPTCHA v3 site key here to turn it on.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Stripe (Dashboard → Developers → API keys). Use Connect for marketplace payouts.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend, see EMAIL_SETUP.md)
RESEND_API_KEY=
EMAIL_FROM="Apps Marketplace <hello@apps-marketplace.com>"
